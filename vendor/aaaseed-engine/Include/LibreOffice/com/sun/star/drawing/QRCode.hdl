struct SAL_DLLPUBLIC_RTTI SAL_WARN_UNUSED QRCode {
    inline QRCode();

    inline QRCode(const ::rtl::OUString& Payload_, const ::sal_Int32& ErrorCorrection_, const ::sal_Int32& Border_);

    ::rtl::OUString Payload;
    ::sal_Int32 ErrorCorrection;
    ::sal_Int32 Border;
};

#ifdef _WIN32
