	
#define speed_min			aaa_cu_float[0]
#define speed_max			aaa_cu_float[1]
#define speed_factor		aaa_cu_float[2]
#define dt					aaa_cu_float[3]
#define field_inf			aaa_cu_float[4]
#define	speed_axe_min		aaa_cu_vec4[0].xyz
#define	speed_axe_factor	aaa_cu_vec4[1].xyz

#define	s_test				aaa_cu_int[0]
CONST int	nb_u		=	aaa_cu_int[2];
CONST int	nb_v		=	aaa_cu_int[3];
CONST float du			=	aaa_cu_float[5];
CONST float dv			=	aaa_cu_float[6];

CONST float time		=	aaa_cu_float[7];
CONST float inter_in	=	aaa_cu_float[8];
CONST float inter_range	=	aaa_cu_float[9];

uniform sampler2D	aaa_samp1;
#define TEX_GRAD	aaa_samp1
uniform sampler2D	aaa_samp2;
#define TEX_COLOR	aaa_samp2


layout(binding = 0) uniform particles_settings_block		{	uint nb;
//todo add																uint type;
															} u_particles_settings;
#define particle_nb  		u_particles_settings.nb
#define PARTICLE_TYPE  		1	//u_particles_settings.type		// 0 is full

#define PARTICLE particle_compact
//#define PARTICLE particle_full

layout( std430, binding=0 ) buffer particles_buffer			{	PARTICLE particles[];	};

layout( std430, binding=4 ) buffer particle_pos_out_buffer	{	vec4 pos_out[];			};
layout( std430, binding=5 ) buffer particle_col_out_buffer	{	vec4 col_out[];			};
layout( std430, binding=6 ) buffer particle_norm_out_buffer	{	vec4 norm_out[];		};
layout( std430, binding=7 ) buffer particle_attr_out_buffer	{	vec4 attr_out[];		};



#define GROUP_SIZE 512
layout( local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;
//layout( local_size_variable ) in;

void main(void)
{
	uint index = gl_GlobalInvocationID.x;
//	if( u_particles_settings.particle_count <= index  )
//		return;
	PARTICLE p = particles[index];


	int iv = int(index) / nb_u;
	int iu = int(index) % nb_u;

	float inter_part;
	if( s_test == -2 )
	{
		vec3 target;
		target.x = (iu + .5 - nb_u*.5) * du;
		target.y = (iv + .5 - nb_v*.5) * dv;
		target.z = 0;
		
		float ph = time * 3 + p.dum.y * 10.;
		inter_part = clamp_01( inter_in + index*du*dv*.5 + p.dum.x * inter_range );
		inter_part = pow( inter_part, 2. );
		target.xyz = mix( target,
						vec3(0,1,0) + vec3( 4*sin(ph)+4, 4+p.dum.z*.0, 4*cos(ph) ),
						inter_part
						);
		//alpha_factor = (1.2-inter_part*inter_part*inter_part);

		p.pos.xyz = mix( target, p.pos.xyz, 1-dt*4. );
		pos_out[index] = p.pos;
		particles[index] = p;
	}
	else if( s_test == -1 )
	{
		vec3 target;
		target.x = (iu + .5 - nb_u*.5) * du;
		target.y = (iv + .5 - nb_v*.5) * dv;
		target.z = 0;
		
		inter_part = clamp_01( -1.1 + inter_in * 2 + index*du*dv*.5 + p.dum.x * inter_range);
		inter_part = pow( inter_part, 1. );
		float ph = inter_part * 10. + p.dum.y * 6.;
	
		float r = max( .5, abs(target.x) );	//radius
		r = (linearstep( 0, .5, inter_part ) + p.dum.z * .5) * 0. ;
	//	r *= pow( p.dum.z , 1-clamp_01(r*10)) * 4.;
		//vec3 target_b = vec3(0,2,0) + vec3( r*sin(ph)/2.3, p.dum.z*.2, r*cos(ph) + p.pos_b.xyz * vec3(.1,.2,.1) );
		vec3 target_b = vec3( -smoothstep( .4, .8, inter_part) * 0, 8*inter_part, 0 ) ;
		target_b += vec3( r*sin(ph)/2.3, p.dum.z*.2, r*cos(ph) );
		target_b.x += noise_simplex( p.pos.xy * 2. +vec2(time*.12,5.23) ) * .4;
		target_b.y += noise_simplex( p.pos.yx * 2. + vec2(5.12+time*.15,56.23) ) * .4;
		target.xyz = mix( target, target_b, inter_part );
		//alpha_factor = (1.2-inter_part*inter_part*inter_part);

		vec3 acc = target - p.pos.xyz;
		float acc_norm = length( acc );
		const float acc_max = 1.;
		const float acc_min = .3;
		float acc_norm_new;
		float acc_ph = smoothstep( acc_min, acc_max, acc_norm );
		float fdt = 12. - 4. * acc_ph;
		float gammma = 1. + acc_ph;
		acc_norm_new = pow( acc_norm, gammma ); 
		acc *= acc_norm_new / max( acc_norm, .000001 );	//max avoid losing particle
		p.vel.xyz += acc * 60 * dt;
		p.vel.xyz *= clamp_01(1 - dt * fdt);
		p.pos.xyz += p.vel.xyz * dt;

		//p.pos.xyz = target.xyz;
		
		pos_out[index] = p.pos;
		particles[index] = p;
	}
	else if( s_test == 0 )
	{
	//	vec4 texture = texture2D( TEX_PART, p.pos.xz + .5 );
	//	vec4 texture = texture2D( TEX_PART, p.pos.xy );
		vec3 speed = speed_axe_min + p.dum.xyz * speed_axe_factor;
		vec2 grad = get_gradient_2d( TEX_GRAD, p.pos.xy + .5 );
		speed *= speed_factor * dt;
		speed.xy += grad * dt * 2. * field_inf;
		vec3 pos = p.pos.xyz;
		pos += speed;
		pos = mod( pos + .5, vec3(1.) ) - .5;
		p.pos.xyz = pos;

	//	p.pos.z 	= clamp( position_world.xyz, vec3(-1), vec3(1.) );

	//	vec4 texture = texture2D( TEX_COLOR, pos.xy+.5 );

		particles[index] = p;

		pos_out[index] = vec4( p.pos.xyz, 1. );
	}
	else if( s_test == 1 )
		pos_out[index] = vec4( p.pos.xyz, 1. );
	else if( s_test == 2 )
		pos_out[index] = vec4( p.pos_b.xyz, 1. );
#if PARTICLE_TYPE==0
	else if( s_test == 3 )
		pos_out[index] = vec4( p.pos_c.xyz, 1. );
#endif
	else if( s_test == 4 )
		pos_out[index] = vec4( p.dum.xyz, 1. );

//	pos_out[index].y = dot( texture.xyz, vec3(1) ) * .3 - .5;
	col_out[index] = vec4( 1., 1., 1., 1. );	// * texture;
//	col_out[index].rgb *= texture.rgb;
//	col_out[index] = texture * aaa_cu_vec4[0];
	norm_out[index] = vec4( 0., 0., 1., 0.);
	attr_out[index] = vec4( p.dum.xyz, 0. ); //inter_part );
}