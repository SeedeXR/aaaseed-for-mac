	
#define speed_min				aaa_cu_float[0]
#define speed_max				aaa_cu_float[1]
#define speed_factor			aaa_cu_float[2]
#define dt						aaa_cu_float[3]
#define field_inf				aaa_cu_float[4]
#define	speed_axe_min			aaa_cu_vec4[0].xyz
#define	speed_axe_factor		aaa_cu_vec4[1].xyz

#define	s_test					aaa_cu_int[0]

uniform sampler2D	aaa_samp1;
#define TEX_GRAD	aaa_samp1
uniform sampler2D	aaa_samp2;
#define TEX_COLOR	aaa_samp2


layout(binding = 0) uniform particles_settings_block		{	uint nb;
//todo add																uint type;
															} u_particles_settings;
#define particle_nb  		u_particles_settings.nb
#define PARTICLE_TYPE  		1	//u_particles_settings.type		// 0 is full

#define PARTICLE particle_compact

layout( std430, binding=0 ) buffer particles_buffer			{	PARTICLE particles[];	};

layout( std430, binding=4 ) buffer particle_pos_out_buffer	{	vec4 pos_out[];			};
layout( std430, binding=5 ) buffer particle_col_out_buffer	{	vec4 col_out[];			};
layout( std430, binding=6 ) buffer particle_norm_out_buffer	{	vec4 norm_out[];		};
layout( std430, binding=7 ) buffer particle_attr_out_buffer	{	vec4 attr_out[];		};



#define GROUP_SIZE 512
layout( local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;
//layout( local_size_variable ) in;

void main(void)
{
	uint index = gl_GlobalInvocationID.x;
//	if( u_particles_settings.particle_count <= index  )
//		return;
	PARTICLE p = particles[index];

	if( s_test == 0 )
	{
	//	vec4 texture = texture2D( TEX_PART, p.pos.xz + .5 );
	//	vec4 texture = texture2D( TEX_PART, p.pos.xy );
		vec3 speed = speed_axe_min + p.dum.xyz * speed_axe_factor;
		vec2 grad = get_gradient_2d( TEX_GRAD, p.pos.xy + .5 );
		speed *= speed_factor * dt;
		speed.xy += grad * dt * 2. * field_inf;
		vec3 pos = p.pos.xyz;
		pos += speed;
		pos = mod( pos + .5, vec3(1.) ) - .5;
		p.pos.xyz = pos;

	//	p.pos.z 	= clamp( position_world.xyz, vec3(-1), vec3(1.) );

	//	vec4 texture = texture2D( TEX_COLOR, pos.xy+.5 );

		particles[index] = p;

		pos_out[index] = vec4( p.pos.xyz, 1. );
	}
	else if( s_test == 1 )
		pos_out[index] = vec4( p.pos.xyz, 1. );
	else if( s_test == 2 )
		pos_out[index] = vec4( p.pos_b.xyz, 1. );
#if PARTICLE_TYPE==0
	else if( s_test == 3 )
		pos_out[index] = vec4( p.pos_c.xyz, 1. );
#endif
	else if( s_test == 4 )
		pos_out[index] = vec4( p.dum.xyz, 1. );

//	pos_out[index].y = dot( texture.xyz, vec3(1) ) * .3 - .5;
	col_out[index] = vec4( 1., 1., 1., 1. );	// * texture;
//	col_out[index].rgb *= texture.rgb;
//	col_out[index] = texture * aaa_cu_vec4[0];
	norm_out[index] = vec4( 0., 0., 1., 0.);
	attr_out[index] = p.dum;
}