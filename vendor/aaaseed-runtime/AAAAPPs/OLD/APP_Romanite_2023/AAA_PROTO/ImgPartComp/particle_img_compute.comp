#define GROUP_SIZE 512
layout( local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;
//layout( local_size_variable ) in;

CONST vec2 ts_over = 1. / textureSize( TEX_FIELD, 0 );
CONST vec2 dtx = vec2(ts_over.x,.0);
CONST vec2 dty = vec2(.0,ts_over.y);

vec2 get_field_gradient( in vec2 at )
 {
 	return vec2(	texture( TEX_FIELD, at + dtx ).r - texture( TEX_FIELD, at - dtx ).r,
	 				texture( TEX_FIELD, at + dty ).r - texture( TEX_FIELD, at - dty ).r
				);
 }

