CONST float demolition_inter	= aaa_cu_float[6];
CONST float demolition_range	= aaa_cu_float[7];
CONST float demolition_factor	= 1. / (1. + demolition_range);

CONST float target_inter		= aaa_cu_float[8];

CONST float magnet				= aaa_cu_float[9];
CONST float viscosity_as_factor	= aaa_cu_float[10];
CONST float accel_max			= aaa_cu_float[11];
CONST float accel_factor		= aaa_cu_float[12];

CONST float mass_jitter			= aaa_cu_float[13];
CONST float field_inf			= aaa_cu_float[14];
