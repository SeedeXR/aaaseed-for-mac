				//float fdt = 12. + part.dum.z * 5.;
			
				float gammma = 1. + acc_ph;
				float acc_norm_new = pow( dist, gammma ); 
				acc *= acc_norm_new / max( dist, .0001 );	//max avoid losing particle
				}
				break;
			case 2:
				{			
					float acc_norm = length(acc);
					if( acc_norm > accel_max )
						acc *= accel_max / acc_norm;
				}
				break;
			}


			part.vel.xyz = part.vel.xyz * viscosity_as_factor + acc * accel_factor * dt;

			part.pos.xyz += part.vel.xyz * dt;
