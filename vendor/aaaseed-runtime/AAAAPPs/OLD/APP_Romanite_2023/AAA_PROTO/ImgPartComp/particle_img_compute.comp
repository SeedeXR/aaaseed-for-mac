CONST float field_see			= aaa_cu_float[16];

CONST vec3	world_center		= aaa_cu_vec4[0].xyz;
CONST float z_for_rot			= aaa_cu_vec4[0].w;
CONST vec3	world_size	 		= aaa_cu_vec4[1].xyz;
CONST float rot_y		 		= aaa_cu_vec4[1].w;
CONST vec3	target_offset		= aaa_cu_vec4[2].xyz;
CONST vec3	target_factor		= aaa_cu_vec4[3].xyz;

CONST int	s_test				= aaa_cu_int[0] & 0xff;
