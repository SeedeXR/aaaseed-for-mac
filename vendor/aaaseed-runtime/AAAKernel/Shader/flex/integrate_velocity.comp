#define PHASE_FLUID 2135949312
#define PHASE_NONE 0

struct st_part_custom
{
	uint  _active;
	float _age;
	float _emitter_sel;
	int   _hit_test;
};

CONST float	time					= aaa_cu_float[0];

CONST float	density_y				= aaa_cu_float[4];
CONST float	fall_age				= aaa_cu_float[5];
CONST float	fall_speed				= aaa_cu_float[6];
CONST float	fall_speed_time_factor	= aaa_cu_float[7];

CONST float velx					= aaa_cu_vec4[0].x;
CONST int	s_hack					= aaa_cu_int[0];


//note, since we run acceleration + integrate back to back, we just bind pos/vel/accel directly and dispatch once with each shader
layout( std430, binding=0 ) buffer particles_pos_outbuffer			{	vec4			pos_out[];			};
layout( std430, binding=1 ) buffer particles_vel_out_buffer	        {	float			vel_out[];			};
layout( std430, binding=2 ) buffer particles_phase_out_buffer	    {	uint			phase_out[];		};
layout( std430, binding=3 ) buffer particles_custom_out_buffer		{	st_part_custom	custom_out[];		};

layout( std430, binding=4 ) buffer particles_free_indices_buffer	{	uint  			free_indices_out[];	};
layout( std430, binding=5 ) buffer particles_free_accum_buffer		{	uint 			free_accum_out[]; 	};

layout( std430, binding=6 ) buffer particle_density_in_buffer	    {	float			dens_in[];			};

layout(binding = 0) uniform particles_settings_block
{
	st_flex_solver sd;
} u_particles_settings;

//texture inputs
layout(binding = 0) uniform sampler2D g_input_texture;

//texture inputs
layout(binding = 2) uniform sampler2D g_dist_texture;

#define GROUP_SIZE 512
layout( local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;

float calcDist(vec2 p)
{
	return texture( g_dist_texture,  p).r;
}

vec2 comp_gradient(vec2 p)
{
	vec2 n = vec2(0.0);
	const vec2 offset_x = vec2( 1./1344.,0 );
	const vec2 offset_y = vec2( 0, 1./384. );

	n.x = calcDist(p + offset_x) - calcDist(p - offset_x);
	n.y = calcDist(p + offset_y) - calcDist(p - offset_y);

	return n;
//	return normalize(n);	// 3/

}

void main(void)
{
	uint index = gl_GlobalInvocationID.x;
	if( u_particles_settings.sd._active_nb <= index  )
		return;

	vec4 p = pos_out[index];
	vec3 v = vec3( vel_out[index*3], vel_out[index*3+1], vel_out[index*3+2]);
	st_part_custom custom = custom_out[index];

	float dens = dens_in[index];
	v.y -= dens * density_y;

	float dt = u_particles_settings.sd._dt;

	bool is_user = custom._emitter_sel > 0.5;	// dans une personne

	//force.y -= abs(sin(p.x+p.y*4.0)) * 0.3;

	float sh = 16.;		// size half
	ivec2 image_size = textureSize(	g_input_texture, 0 );

	vec2 uv_step = 1.0 / vec2(image_size);
	float ratio = image_size.x / image_size.y;

//	vec2 uv = p.xz / 4. + .5;
	vec2 uv = p.xy / vec2(8.,4.5) + .5;

	float hit_ref_val = 0.1;
	//

	float t = texture( g_input_texture, uv ).r;
	custom._hit_test = t > hit_ref_val ? 1 : 0;

//	float df = texture ( g_dist_texture,  uv ).r;
#if 0
	//repulse by texture	
	vec2 rep = get_gradient_2d( g_dist_texture,  uv );
	vec3 force  = vec3( rep, 0 );
	v += force * dt * 100.;
#endif

	bool b_reset = false;
	if( custom._active==1 )
	{
		custom._age += u_particles_settings.sd._dt;
		if( custom._age > 8. )
			b_reset  = true;
		//custom._active = custom._age < age_fall ? 1 : 0;
		else if( any( greaterThan( abs(p.zz), vec2(4.) ) ) ) 
			b_reset  = true;
		else if( p.y < -3. )
		{
			b_reset  = true;
#if 0
			//repulse and rotate
			vec2 p2 = (p.xz - vec2( 1, 0 )) * .5;
			float d2 = dot(p2,p2);
			if( d2 < 1. )
			{
				if( d2 < .01 )
					b_reset  = true;
				else
					v.xz -= p2 * .2 / d2;
					v.xz += vec2( -p2.y, p2.x ) * .2  / d2;
			}
			else
#endif
#if 0
			{
				if( p.y < 0. ) 
				{
					//p.y = 0.;
					v.y -= p.y * 20;
				}
				v.z += .2;
			}
#endif
		}
	}
	else
		b_reset = true;

	if(  b_reset )
	{
		if( s_hack > 0 )
		{	//hack maa to see stuff again in bdd_flex
			//understand and refine please
			custom._active = 1;
			custom._age = 0.;
			custom._emitter_sel = 0;

			phase_out[index] = PHASE_FLUID;
			//p.x = 0;	// + p.z * .2;
			//p.x =   2. * float(index % 269) / 256. - 1.;
			const int nb_p2 = 10;
			const int nb = 1 << nb_p2;
			const float nb_f = float(nb);
			const float size = 8.;	//was 5.
			p.x =   size * ( float(index % nb)			/ nb_f - .5 );
			p.z =   size * ( float((index>>nb_p2) % nb) / nb_f - .5);
			//p.y = min( p.y + 5.,  10. );
			p.y = 2.5;
			p.y +=  .5 * float(index % 256) / 256.;
//			p.z *= .1;
			v = vec3(0);
			v.x = velx;
		}
	}

	pos_out[index] = p;

	if( custom._active==0 )
	{
		uint accum_index = atomicAdd(free_accum_out[0], 1);
		free_indices_out[accum_index] = index;
		phase_out[index] = PHASE_NONE;
	}

	custom_out[index] = custom;

	vel_out[index*3] = v.x;
	vel_out[index*3+1] = v.y;
	vel_out[index*3+2] = v.z;

	//phase_out[index] = custom._active > 0 ? PHASE_FLUID : PHASE_NONE;
}