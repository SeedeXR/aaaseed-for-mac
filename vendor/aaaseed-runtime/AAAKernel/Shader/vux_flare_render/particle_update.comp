

//todo try with small
#define PARTICLE particle_full

#define speed_min			aaa_cu_float[0]
#define speed_max			aaa_cu_float[1]
#define speed_factor		aaa_cu_float[2]
#define dt					aaa_cu_float[3]
#define	speed_factor_axe	aaa_cu_vec4[0].xyz
CONST float	coverage_u	=	aaa_cu_vec4[1].x;
CONST float	coverage_v	=	aaa_cu_vec4[1].y;
CONST float	coverage	=	aaa_cu_vec4[1].z;
uniform sampler2D 	aaa_tex2d[];
//uniform	sampler2D	aaa_samp0;
//was std140
layout( std430, binding=0 ) buffer particles_buffer			{	PARTICLE particles[];	};

layout( std430, binding=4 ) buffer particle_pos_out_buffer	{	vec4 pos_out[];			};
layout( std430, binding=5 ) buffer particle_col_out_buffer	{	vec4 col_out[ ];		};
layout( std430, binding=6 ) buffer particle_norm_out_buffer	{	vec4 norm_out[ ];		};
layout( std430, binding=7 ) buffer particle_attr_out_buffer	{	vec4 attr_out[ ];		};

layout(binding = 0) uniform particles_settings_block		{	uint particle_count;	} u_particles_settings;

#define GROUP_SIZE 512
layout( local_size_x = GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;

void main(void)
{
	uint index = gl_GlobalInvocationID.x;
//	if( u_particles_settings.particle_count <= index  )
//		return;

	PARTICLE p = particles[index];

//	vec4 texture = texture2D( aaa_tex2d[0], p.pos.xz + .5 );
//	vec4 texture = texture2D( aaa_samp0, p.pos.xy );

	vec3 pos = p.pos.xyz + vec3(.5);	//now in [0,1]
	vec3 speed = ( (p.dum.xyz) - vec3( .5, 0., .5 ) ) * speed_factor_axe; //(speed_max-speed_min);
	speed *= speed_factor;

	if( coverage > 0 )
	{
		float fh = 1. - smoothstep( .5, 2.5, pos.y * 9. );

		float d = (pos.x - .5) * 3. -  (coverage_u - .5 );	// dist on u
		float fd = (1. - smoothstep( 0., .25, abs(d) ) );
		float f = sqrt(coverage) * fh * fd * 1.;

		//speed.y *= fd * 20.* f;
		speed.x += sign(d) * f; // * (0.5 + coverage_v );
		//speed.z = (coverage_v-.5) * f;
	}

	//vec3 speed = vec3(0.01);
	pos += speed * dt;
	pos = fract( pos ) - vec3(.5);
	p.pos.xyz = pos;

//	p.pos.z 	= clamp( position_world.xyz, vec3(-1), vec3(1.) );

	particles[index] = p;

//	pos_out[index] = vec4( p.pos.xyz * .1 - .1, 1. );
	pos_out[index] = vec4( p.pos.xyz, 1. );
//	pos_out[index].y = dot( texture.xyz, vec3(1) ) * .3 - .5;
	col_out[index] = vec4( 1, 1, 1, 1 );	// * texture;
//	col_out[index] = texture * aaa_cu_vec4[0];
	norm_out[index] = vec4( 0., 0., 1., 0.);
	attr_out[index] = p.dum;
}

